# Server only. Copy to .env; never use VITE_ prefixes for credentials.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Keys alone do not enable inference or paid evaluation.
LUMI_COGNITION_ENABLED=false
LUMI_COGNITION_MODEL=qwen/qwen3.7-flash
LUMI_DECISIONS_ENABLED=false
# Application-wide, not part of world/branch checkpoints. Keep this directory across restarts.
# Default: %LOCALAPPDATA%/AutonomousLumi/cognition-budget (Windows).
# LUMI_COGNITION_BUDGET_DIRECTORY=
LUMI_COGNITION_BUDGET_USD=1
LUMI_COGNITION_ALLOW_HIGHER_BUDGET=false
LUMI_COGNITION_CONCURRENCY=1
LUMI_COGNITION_QUEUE=1
LUMI_COGNITION_MAX_OUTPUT_TOKENS=768
LUMI_COGNITION_DEADLINE_MS=15000
LUMI_COGNITION_MIN_REAL_INTERVAL_MS=10000
LUMI_COGNITION_MIN_WORLD_INTERVAL_SECONDS=10
# Conservative OpenRouter full-route-context reservation and enforced route price caps ($/1M tokens).
# When changing the model, explicitly configure its documented full context ceiling.
LUMI_COGNITION_ROUTE_CONTEXT_TOKENS=1000000
LUMI_COGNITION_MAX_INPUT_USD_PER_MILLION=0.1
LUMI_COGNITION_MAX_OUTPUT_USD_PER_MILLION=0.3
# Decisions fixed endpoint/model, text only: full 1.05M context at buffered $.50/M.
# This is an admission estimate, not a provider-enforced account billing cap.
LUMI_DECISIONS_RESERVATION_USD=0.525

# Physiology activation is a PROCESS variable, not loaded from this .env file.
# New/older histories default inactive; leave unset to preserve a schema-6 restored gate.
# PowerShell: $env:LUMI_PHYSIOLOGY_ACTIVE = 'true' (or 'false' to freeze it).
# Remove-Item Env:LUMI_PHYSIOLOGY_ACTIVE restores saved-gate/new-history defaults.
