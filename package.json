{
  "name": "autonomous-lumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n world,viewer \"npm:dev:server\" \"npm:dev:viewer\"",
    "dev:server": "tsx server/dev.ts",
    "dev:viewer": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "diagnostics:export": "tsx server/diagnostics/cli.ts export",
    "diagnostics:incident": "tsx server/diagnostics/cli.ts incident",
    "replay": "tsx server/diagnostics/cli.ts replay",
    "diagnostics:benchmark": "tsx server/diagnostics/benchmark.ts",
    "vision:capture": "tsx server/vision/cli.ts",
    "vision:benchmark": "tsx server/vision/benchmark.ts",
    "vision:verify": "tsx --test tests/vision-renderer.real.ts",
    "vision:attention": "tsx --test tests/vision-attention.real.ts",
    "physiology:lab": "tsx server/physiology-lab.ts",
    "cognition:verify": "tsx server/cognition/verify.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  }
}
